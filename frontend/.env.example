# Sahaay Flutter App Environment Configuration
# Use with --dart-define or flutter_dotenv

# Base URL for the Express Backend API
# For Android emulator: http://10.0.2.2:3000/api/v1
# For Web or Desktop: http://localhost:3000/api/v1
API_BASE_URL=http://localhost:3000/api/v1

# Socket.IO Real-time Gateway
SOCKET_URL=http://localhost:3000

# Default Simulation Coordinates (Koramangala, Bengaluru)
DEFAULT_LATITUDE=12.9352
DEFAULT_LONGITUDE=77.6245

# Demo Mode (enables instant offline fallback and simulated transitions)
DEMO_MODE=true
