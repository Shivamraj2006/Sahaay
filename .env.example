# Sahaay Frontend Environment Configuration
# Use with --dart-define or inject during build/run

# API Base URL (must include /api/v1)
API_BASE_URL=http://localhost:3000/api/v1

# Socket.IO Gateway URL (without /api/v1 path)
SOCKET_BASE_URL=http://localhost:3000

# Optional FCM configuration flag
ENABLE_FCM=false
