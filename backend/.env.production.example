# ══════════════════════════════════════════════════════════════════════════════
# SAHAAY BACKEND — PRODUCTION ENVIRONMENT CONFIGURATION
# ══════════════════════════════════════════════════════════════════════════════

# ─── 1. SERVER ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
CORS_ORIGIN=*

# ─── 2. DATABASE (MongoDB Atlas or Cloud Cluster) ─────────────────────────────
# Use your MongoDB Atlas connection string (or self-hosted replica set)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sahaay?retryWrites=true&w=majority

# ─── 3. AUTHENTICATION & SECURITY ─────────────────────────────────────────────
# Generate a strong 64-character secret: openssl rand -base64 48
JWT_SECRET=replace-with-a-cryptographically-secure-random-secret
JWT_EXPIRES_IN=24h

# ─── 4. GEOSPATIAL MATCHING ENGINE ────────────────────────────────────────────
MATCHING_INITIAL_RADIUS_M=500
MATCHING_SECOND_RADIUS_M=1000
MATCHING_MAX_RADIUS_M=3000
MATCHING_LOCATION_FRESHNESS_MIN=5
MATCHING_EXPANSION_DELAY_MS=10000

# ─── 5. BLOCKCHAIN TRUST LAYER (MVP SPECIFICS) ────────────────────────────────
# Option A: MVP Simulation Mode (Recommended for quick hackathon/cloud hosting)
# Leave BLOCKCHAIN_RPC_URL and BLOCKCHAIN_PRIVATE_KEY empty.
# The server will automatically generate and verify SHA-256 cryptographic digests,
# simulate on-chain transaction hashes, and confirm proofs without requiring gas.
#
# Option B: Live EVM Testnet (Sepolia, Polygon Amoy, Arbitrum Sepolia)
# Set your testnet RPC and funded attestor private key:
BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
BLOCKCHAIN_PRIVATE_KEY=0xYOUR_ATTESTOR_HOT_WALLET_PRIVATE_KEY
BLOCKCHAIN_CHAIN_ID=11155111
BLOCKCHAIN_EMERGENCY_LEDGER_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
BLOCKCHAIN_RESPONDER_REGISTRY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ─── 6. RATE LIMITING ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
