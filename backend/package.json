{
  "name": "sahaay-backend",
  "version": "1.0.0",
  "description": "Sahaay community emergency-response backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/contracts', {recursive:true}); fs.cpSync('src/contracts', 'dist/contracts', {recursive:true});\"",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "tunnel": "npx -y localtunnel --port 3000",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "socket.io": "^4.8.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
