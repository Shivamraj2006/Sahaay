# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sahaay

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRES_IN=24h

# Matching
MATCHING_INITIAL_RADIUS_M=500
MATCHING_SECOND_RADIUS_M=1000
MATCHING_MAX_RADIUS_M=3000
MATCHING_LOCATION_FRESHNESS_MIN=5
MATCHING_EXPANSION_DELAY_MS=10000

# Blockchain (optional — graceful fallback if absent)
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_EMERGENCY_LEDGER_ADDRESS=
BLOCKCHAIN_RESPONDER_REGISTRY_ADDRESS=
BLOCKCHAIN_REPUTATION_ADDRESS=
BLOCKCHAIN_CHAIN_ID=31337

# FCM (optional — graceful fallback if absent)
FCM_SERVICE_ACCOUNT_PATH=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
